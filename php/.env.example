# Flutterwave (portfolio template deposits)
# Get keys from https://dashboard.flutterwave.com/
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# Optional — defaults to {BASE_URL}/portfolio-app/order/success
# FLUTTERWAVE_REDIRECT_URL=http://localhost:5175/ulnovatech/portfolio/order/success

# Shared with php/config.php
BASE_URL=http://localhost/ulnovatech
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ulnovatech

# SleeklyBuilt Attendant — locked model: Gemini 2.5 Flash Lite
# Prefer Google AI Studio key (GEMINI_API_KEY). OpenRouter keys (sk-or-…) also work as transport.
GEMINI_API_KEY=
# OPENROUTER_API_KEY=   # optional fallback if GEMINI_API_KEY is empty
# Optional Layer B live eval: ATTENDANT_LIVE_EVAL=1 php php/attendant/tests/live_eval.php
# ATTENDANT_LIVE_EVAL=
