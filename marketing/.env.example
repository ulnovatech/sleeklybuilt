# Copy to .env.production or export in the shell before build.
VITE_SITE_URL=https://sleeklybuilt.pro
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX

# Operator bridge (/performante) — same Clerk app as Discovery /dash / admin-mobile
# REQUIRED for production builds that expose the bridge.
VITE_CLERK_PUBLISHABLE_KEY=
# Prefer user id; if both id and email are set, both must match (fail closed).
VITE_CLERK_ADMIN_USER_ID=
# VITE_CLERK_ADMIN_EMAIL=you@sleeklybuilt.pro
# Optional Discovery absolute URL override for the bridge list
# VITE_DISCOVERY_URL=https://discovery.sleeklybuilt.pro
