# =============================================================================
# Single project env file — copy to `.env` at this repo root only.
# Do NOT duplicate into apps/dashboard/.env.local
#
# API keys (Places, CSE, Brave, Meta): Settings → API credentials in the UI.
# Env fallbacks below are optional (CI/production secrets injection only).
# =============================================================================

# --- Required ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/agency_platform
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local password bypass is permanently disabled. Clerk + allowlist required.
# ALLOW_DEV_AUTH is ignored by the app.
ALLOW_DEV_AUTH=false

# --- Auth (required for admin console) ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_ADMIN_USER_ID=
# Optional fallback if user id not set:
# CLERK_ADMIN_EMAIL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/ops
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/ops

# Local dev only: drain pipeline inside Next.js (not for production)
# INLINE_PIPELINE=true

# --- Storage ---
STORAGE_LOCAL_PATH=./storage/uploads

# --- Acquisition mode & budget caps (or edit in Settings UI) ---
ACQUISITION_MODE=standard
PLACES_MONTHLY_CAP=600
CSE_DAILY_CAP=100
BRAVE_DAILY_CAP=50
# Bing Web Search API retired Aug 2025 — leave 0 unless BING_SEARCH_LEGACY_ENABLED=true
BING_DAILY_CAP=0
META_GRAPH_DAILY_CAP=50
BROWSER_DAILY_CAP=10
CUSTOM_SCRAPE_DAILY_CAP=50

# Places dormancy (Plan B): skips Places + CSE API calls; OSM/search/Meta/CSV continue.
# Places provider code stays intact for reactivation when billing is healthy.
# GOOGLE_ACQUISITION_DISABLED=true
# Free OpenStreetMap Plan B backbone (default on). Set false to disable:
# OSM_DISCOVERY_ENABLED=true
# OSM_USER_AGENT=SleeklyBuiltDiscovery/1.0 (+https://yoursite.com; contact@you)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Geofabrik Uganda extract (Plan B backbone). Refresh: pnpm discovery:osm-geofabrik
# OSM_PBF_PATH=./storage/osm/uganda-latest.osm.pbf
# OSM_GEOFABRIK_URL=https://download.geofabrik.de/africa/uganda-latest.osm.pbf
# OSM_FORCE_OVERPASS=true

# --- Optional feature flags ---
# BROWSER_AUTOMATION_ENABLED=true
# CUSTOM_SCRAPE_ENABLED=true

# --- Optional: API key env fallbacks (prefer Settings UI) ---
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_API_KEYS=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# BRAVE_SEARCH_API_KEY=
# BING_SEARCH_KEY=
# BING_SEARCH_LEGACY_ENABLED=true
# META_GRAPH_API_TOKEN=
# Pages Search App Review gate (Plan B). Prefer live probe: pnpm discovery:meta-probe
# META_PAGES_SEARCH_READY=true
# META_PAGES_SEARCH_READY=false

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Cron (production HTTP polls) ---
# Compared with crypto.timingSafeEqual (Bearer or X-Cron-Secret).
CRON_SECRET=

# Default review/work-queue score floor (0 disables). Overridable in Settings UI.
# QUALIFICATION_MIN_SCORE_DEFAULT=25

# --- SleeklyBuilt / sleekly-dash Operations CRM bridge (C6–C7) ---
# Same Docker network as hub: SLEEKLY_DASH_BASE_URL=http://nginx
# Leave token empty until integrations service token exists (no mock sync).
SLEEKLY_DASH_BASE_URL=
SLEEKLY_DASH_SERVICE_TOKEN=

# --- Gmail OAuth (optional) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
