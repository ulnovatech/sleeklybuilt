# Docker Compose env — copy to docker.sleeklybuilt.env (gitignored) before `docker compose up`
# Mounted into php-fpm only at public_html/php/.env and sleekly-dash/backend/.env.
# Host stubs under public_html must stay empty; nginx denies /.env and /ulndash/.
# Google credentials: /opt/sleeklybuilt/secrets/service-account.json → /var/www/secrets (not docroot).
#
# Production (Linode VM):
#   cp docker.sleeklybuilt.env.example docker.sleeklybuilt.env
#   Place secrets under /opt/sleeklybuilt/secrets/ (see infra/env/README.md)

# --- Shared MySQL (php + sleekly-dash) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sleeklybuilt
DB_USER=sleeklybuilt
DB_PASS=sleeklybuilt_dev_change_me

# Public site URL (forms, redirects, Flutterwave callbacks)
# Local:  http://localhost:8080
# Production: https://sleeklybuilt.pro  (see docs/ACCESS.md)
BASE_URL=http://localhost:8080
# After publish, gallery shots load pages via BASE_URL (or TEMPLATE_SCREENSHOT_BASE_URL).
# TEMPLATE_SCREENSHOT_BASE_URL=https://sleeklybuilt.pro
# TEMPLATE_SCREENSHOT_NODE=/usr/bin/node
# TEMPLATE_SCREENSHOT_CHROMIUM=/usr/bin/chromium

# --- sleekly-dash CRM ---
APP_DEBUG=false
API_BASE=/api/
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5174,http://localhost:5177,http://127.0.0.1:8080
# Production:
# APP_DEBUG=false
# ALLOWED_ORIGINS=https://sleeklybuilt.pro,https://www.sleeklybuilt.pro,https://discovery.sleeklybuilt.pro
# BASE_URL=https://sleeklybuilt.pro

DASH_ADMIN_USER=admin
DASH_ADMIN_EMAIL=sales@sleeklybuilt.pro
# Initial mother account password (ensureMotherAccount). Change after first sign-in.
DASH_ADMIN_PASS=changeme
# After rotating the mother password, prefer a bcrypt hash and unset DASH_ADMIN_PASS:
# Generate: php -r "echo password_hash('YOUR_STRONG_PASSWORD', PASSWORD_BCRYPT), PHP_EOL;"
# DASH_ADMIN_PASS_HASH=$2y$10$...
# After first admin exists, keep public signup closed (create accounts in Settings → Team)
# DASH_ALLOW_PUBLIC_SIGNUP=false
# DASH_AUTH_EXPOSE_RESET_LINK=true
MAIL_FROM=noreply@sleeklybuilt.pro

# Clerk SSO for dash / admin-mobile (see docs/AUTH_SSO.md)
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=https://YOUR_CLERK_FRONTEND_API/.well-known/jwks.json
CLERK_ISSUER=https://YOUR_CLERK_FRONTEND_API
CLERK_ADMIN_USER_ID=
# CLERK_ADMIN_EMAIL=you@sleeklybuilt.pro
# CLERK_AUTHORIZED_PARTIES=

MOBILE_JWT_SECRET=dev_only_change_before_production_use_64_hex_chars_minimum________
# Production: openssl rand -hex 32

# --- Google Analytics Data API for dash /analytics (optional) ---
# Numeric property ID from Admin → Property details (not G-XXXX, not stream ID).
GA_PROPERTY_ID=552660541
# Path relative to sleekly-dash/backend/, or absolute inside php-fpm:
#   /var/www/secrets/service-account.json  (Linode: /opt/sleeklybuilt/secrets)
GA_CREDENTIALS_PATH=/var/www/secrets/service-account.json

# --- Firebase Cloud Messaging (admin mobile push alerts) ---
# Enable Firebase Cloud Messaging API on the GCP project; use a service account JSON.
# Place the file at /opt/sleeklybuilt/secrets/service-account.json on the VM.
# php-fpm mounts that directory at /var/www/secrets (survives public_html rsync).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=/var/www/secrets/service-account.json
# Falls back to GA_CREDENTIALS_PATH when FCM_CREDENTIALS_PATH is unset

# --- Flutterwave (portfolio payments) ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Marketing GA4 is build-time (Vite), not this PHP runtime file:
#   VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
# Set it in the shell when running scripts/build-production.sh, then rebuild.

# --- SleeklyBuilt Attendant (Gemini 2.5 Flash Lite) ---
# Google AI Studio key preferred. OpenRouter sk-or-… keys work as HTTP transport for the same model.
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
