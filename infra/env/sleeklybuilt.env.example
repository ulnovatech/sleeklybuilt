# Naming alias — same template as docker.sleeklybuilt.env.example
#
# The Oracle deploy plan uses "sleeklybuilt.env" in docs; Docker Compose mounts
# infra/env/docker.sleeklybuilt.env on the VM. Use either name on disk; only the
# path passed to SLEEKLYBUILT_ENV_FILE matters.
#
# Canonical template:
#   infra/env/docker.sleeklybuilt.env.example
#
# On the server:
#   cp docker.sleeklybuilt.env.example /opt/sleeklybuilt/env/docker.sleeklybuilt.env
#
# Do not commit live .env files (see repo .gitignore).
