# Sleekly Dash CRM (sleekly-dash) — copy to sleekly-dash/backend/.env

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sleeklybuilt
DB_USER=root
DB_PASS=

APP_DEBUG=true
API_BASE=/api

# Private, writable directory outside the public portfolio tree.
# Defaults to the OS temp directory when omitted.
TEMPLATE_IMPORT_STAGING_DIR=
# Persistent worker logs; production uses /var/log/sleeklybuilt/template-import.
TEMPLATE_IMPORT_LOG_DIR=
# Private section profiles, expiring drafts, and one-step content backups.
TEMPLATE_PROFILE_DIR=
# Defaults to wget from PATH.
TEMPLATE_IMPORT_WGET_BINARY=wget
# Per authenticated user. Allowed range: 1–100.
TEMPLATE_IMPORT_MAX_PER_HOUR=6
TEMPLATE_IMPORT_STAGING_RETENTION_DAYS=7
TEMPLATE_IMPORT_LOG_RETENTION_DAYS=30

# Comma-separated allowed browser origins (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5176,http://localhost:5175,http://localhost:5177,http://localhost:3000,http://localhost/sleeklybuilt,http://hub.34.66.94.12.nip.io,https://sleeklybuilt.pro,https://www.sleeklybuilt.pro

# Dashboard accounts (DB-backed — replaces single hardcoded admin)
# Seed first admin from these when dash_users is empty (after migration):
DASH_ADMIN_USER=admin
DASH_ADMIN_EMAIL=admin@example.com
# Local dev only — use DASH_ADMIN_PASS_HASH in production
DASH_ADMIN_PASS=changeme
# DASH_ADMIN_PASS_HASH=
# Allow open /register after first admin exists (default: off — use Settings → Team)
# DASH_ALLOW_PUBLIC_SIGNUP=false
# Local only: include reset_url in forgot-password JSON when APP_DEBUG=true
# DASH_AUTH_EXPOSE_RESET_LINK=true
MAIL_FROM=noreply@sleeklybuilt.pro
BASE_URL=http://localhost

# Google Analytics service account (path relative to sleekly-dash/backend)
GA_PROPERTY_ID=502536992
GA_CREDENTIALS_PATH=service-account.json

# Mobile admin app JWT (required in production)
MOBILE_JWT_SECRET=

# Discovery bridge — mint tokens with:
#   php sleekly-dash/backend/scripts/mint_integration_token.php --name=discovery
# Raw tokens are never stored; only SHA-256 hashes live in integration_tokens.

# Firebase Cloud Messaging (FCM HTTP v1)
# Use the Firebase/GCP service account JSON with Firebase Cloud Messaging API enabled
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=service-account.json
# Falls back to GA_CREDENTIALS_PATH when FCM_CREDENTIALS_PATH is unset

