# Copy to .env.development or .env.production (do not commit secrets)

VITE_API_BASE=/api

# Clerk SSO (single operator) — same publishable key as Discovery
# When set, /dash uses Clerk Sign-in and sends JWT Bearer to /api
VITE_CLERK_PUBLISHABLE_KEY=

# Federated apps (sidebar external links)
VITE_HOME_SITE_URL=http://localhost/sleeklybuilt/
VITE_BLOG_URL=http://localhost:5173
VITE_PORTFOLIO_URL=http://localhost/sleeklybuilt/portfolio/
# Demand Capture (Discovery Intelligence) — local: http://localhost:3000
VITE_DISCOVERY_URL=http://localhost:3000
