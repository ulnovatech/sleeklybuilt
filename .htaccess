RewriteEngine On

# Proxy API requests to sleekly-dash (legacy ulndash must not serve /api)
RewriteRule ^api/(.*)$ sleekly-dash/backend/$1 [L]

# Deny secret / env files under Apache (XAMPP / local) — mirrors nginx Chunk 1
<FilesMatch "(?i)^(\.env.*|service-account\.json)$">
  Require all denied
</FilesMatch>

# Deny leftover legacy CRM tree if present on disk
RewriteRule ^ulndash(/|$) - [F,L]
