# Copy to .env.production.local (gitignored) before APK / production Vite builds.
# Overrides .env.production. Production build FAILS without Clerk key + absolute API URL.

VITE_API_URL=https://sleeklybuilt.pro/api
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# LAN XAMPP device testing example:
# VITE_API_URL=http://192.168.1.42/sleeklybuilt/api
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
