# Production Vite env for Capacitor / APK builds.
# Absolute API URL is required (vite.config.js fails the build otherwise).
# Put the real Clerk publishable key in .env.production.local (gitignored).

VITE_API_URL=https://sleeklybuilt.pro/api

# Required for production APK — copy into .env.production.local:
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
