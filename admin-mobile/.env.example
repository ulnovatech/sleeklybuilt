# Sleekly Admin Mobile — environment reference
# Copy values into .env.development (browser dev) or .env.production / .env.production.local (APK).
# Vite bakes production env into release APKs at build time.

# --- Browser dev (npm run dev) ---
# Proxied to XAMPP via vite.config.js
VITE_API_URL=/api
VITE_APACHE_BASE=http://localhost/sleeklybuilt
VITE_PORT=5177

# Clerk SSO (single operator) — same publishable key as Discovery /dash
# Optional in browser password-dev mode; REQUIRED for production APK builds.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Production APK (npm run build / build:apk / build:apk:release) ---
# Required (enforced by vite.config.js when mode=production):
#   1. Absolute VITE_API_URL (https://…/api) — see .env.production
#   2. VITE_CLERK_PUBLISHABLE_KEY — set in .env.production.local (gitignored)
#
# Public server default is in .env.production:
#   VITE_API_URL=https://sleeklybuilt.pro/api
#
# Physical device testing against local XAMPP on your LAN:
# 1. Find your PC LAN IP: ipconfig  →  IPv4 Address (e.g. 192.168.1.42)
# 2. Ensure phone and PC are on the same Wi‑Fi
# 3. Override in .env.production.local:
#    VITE_API_URL=http://192.168.1.42/sleeklybuilt/api
#    VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
